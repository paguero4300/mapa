# Configuración del Servidor Traccar
TRACCAR_URL=https://tu-servidor-traccar.com/api

# Puerto del servidor backend
PORT=8080

# Entorno (development/production)
ENV=development

# Secret para JWT - GENERAR UNO NUEVO PARA PRODUCCIÓN
